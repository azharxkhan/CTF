# Copy to .env and fill in real values. NEVER commit .env.
# Flags live here (env vars), never baked into images — see BUILD.md §6.

# --- CTFd ---
CTFD_SECRET_KEY=change-me-long-random
CTFD_DB_PASSWORD=change-me

# --- Vulnerable API database (SQL Server) ---
SA_PASSWORD=Change-Me-Strong-1
# Password for the per-challenge, DB-scoped app logins (c1_app, c2_app, …). These logins can
# only touch their own database — this is what stops cross-DB flag theft via SQL injection.
DB_APP_PASSWORD=Change-Me-App-1
VULN_DB_CONNECTION=Server=vuln-db;Database=Vuln;User Id=sa;Password=Change-Me-Strong-1;TrustServerCertificate=true

# --- Challenge flags (exploit + patch). Per-player rotation seed for some. ---
FLAG_C1_SQLI=flag{parameterize_every_query}
FLAG_C2_IDOR=flag{authorize_per_record_not_per_route}
FLAG_C3_GITSECRET=flag{rotate_dont_just_delete}
FLAG_C4_FROMSQLRAW=flag{fromsql_parameterizes_fromsqlraw_does_not}
FLAG_C5_MASSASSIGN=flag{bind_to_a_dto_never_the_entity}
FLAG_C6_XSS=flag{react_is_safe_until_you_dangerouslysetinnerhtml}
FLAG_C7_PATHTRAVERSAL=flag{resolve_and_confirm_inside_root}
FLAG_C8_WEAKJWT=flag{256_bits_of_random_from_config}
FLAG_C9_JWTOFF=flag{the_defaults_were_secure}
FLAG_C10_BLINDSQLI=flag{no_output_is_still_injection}
FLAG_C11_RACE=flag{transaction_or_rowversion}
FLAG_C12_BUNDLEKEY=flag{anything_shipped_to_the_browser_is_public}
# Challenge 12: the over-privileged API key that gets baked into the JS bundle.
C12_ADMIN_KEY=ak_live_5Xf2Qb8Kd3Np7Rt9Vw1Yz

# --- Warm-up flags (black-box tier) ---
FLAG_W1_PORTRECON=flag{found_the_hidden_port}
FLAG_W2_ENCODING=flag{encoding_is_not_encryption}
# W3 is submit-the-cracked-plaintext (not flag{} format): the answer is the password below.
FLAG_W3_WEAKHASH=letmein
FLAG_W4_HIDDENFILE=flag{metadata_leaks_secrets}

# Per-player flag rotation (anti-cheat): HMAC seed used to derive a unique flag
# suffix per player id, so a copied flag does not validate for someone else.
FLAG_ROTATION_SEED=change-me-long-random

# --- Challenge 8: weak JWT signing key. .NET needs HS256 keys >=32 bytes, so it's a long but
# low-entropy passphrase (crackable; in challenges/jwt-wordlist.txt). ---
JWT_WEAK_KEY=weak-development-jwt-signing-key-please1
# --- Challenge 9: strong signing key (256-bit). The bug there is validation being OFF, not the key. ---
JWT_STRONG_KEY=b8f2c1a9d4e7f0362b5a8c1d9e4f7a0362b5a8c1d9e4f7a0362b5a8c1d9e4f7a0

# --- Guacamole browser gateway ---
GUAC_DB_PASSWORD=change-me
GUACADMIN_PASSWORD=change-me
